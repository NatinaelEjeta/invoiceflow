# ---------------------------------------------------------------------------
# InvoiceFlow environment variables
# ---------------------------------------------------------------------------

# REQUIRED — Prisma connection string.
# Local development (SQLite):   file:./db/custom.db
# Production (Neon PostgreSQL): postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# REQUIRED — Secret used to sign session JWTs (minimum 16 characters).
JWT_SECRET=

# REQUIRED on Vercel — Protects /api/cron/overdue (sent as `Authorization: Bearer <CRON_SECRET>`).
# Generate with: openssl rand -hex 24
CRON_SECRET=

# Public base URL of the app (used in emails, Stripe redirects). No trailing slash.
APP_URL=http://localhost:3000

# OPTIONAL — Stripe (test mode). When STRIPE_SECRET_KEY is empty the app runs
# in DEMO BILLING MODE: "Upgrade to Pro" switches the workspace instantly.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# OPTIONAL — Transactional email via Resend (https://resend.com).
# Without a key, sent emails are logged to the server console instead.
RESEND_API_KEY=
EMAIL_FROM="InvoiceFlow <onboarding@resend.dev>"
